# Machine-specific settings for run-tests.sh — copy to run-tests.env (not committed) and adjust.
VM_SSH_DEST=user@127.0.0.1        # SSH destination of the Windows machine running PQTest
VM_SSH_PORT=22
VM_SSH_KEY=                        # optional path to an SSH private key
VM_TESTS=C:/Users/user/pbitests    # Windows path holding ClickHouse.mez + Tests/
PQTEST=c:\\path\\to\\PQTest.exe     # from the Microsoft.PowerQuery.SdkTools NuGet package
CH_HOST=192.168.0.10               # ClickHouse host address AS SEEN FROM the Windows machine
DOCKER=docker                      # docker CLI (e.g. ~/.orbstack/bin/docker on macOS/OrbStack)
